{#
  Shared Alpine root state, included into the <html x-data="..."> attribute on every page.
  Page-specific state (e.g. contact.html's `form` object, services.html's `seasonRate`)
  is merged in by passing `extraState` (a trailing comma-terminated Alpine object-literal
  fragment) from the page template.
#}
{
    darkMode: false,
    mobileMenuOpen: false,
    modalOpen: false,
    reserveName: '',
    toast: { show: false, message: '' },
    showToast(msg) {
        this.toast.message = msg;
        this.toast.show = true;
        setTimeout(() => { this.toast.show = false; }, 3000);
    },
    {% if extraState %}{{ extraState | safe }}{% endif %}
}
